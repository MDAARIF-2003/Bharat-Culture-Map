# Bharat CultureMap — Environment Configuration Template
# Copy to .env for local overrides, or configure in your Node.js production host.

# Runtime environment: "development" | "test" | "production"
NODE_ENV=development

# HTTP server port
PORT=3000

# REQUIRED IN PRODUCTION: Cryptographically strong HMAC secret (>= 32 characters).
# Generate one via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-bytes-in-production

# Demo accounts & one-click persona switcher:
# - Defaults to true in development/test so local evaluators can inspect personas.
# - Defaults to false in production (NODE_ENV=production) unless explicitly overridden.
ENABLE_DEMO_ACCOUNTS=false

# Persistent SQLite database path (mount on a persistent volume in production)
SQLITE_DB_PATH=./data/bharat_culturemap.sqlite

# Optional comma-separated list of extra hostnames allowed by Vite dev server on local Wi-Fi
# VITE_ALLOWED_HOSTS=my-laptop.local
